"events": [Object(InputEventKey,"device":-1,"physical_keycode":82,"unicode":114), Object(InputEventJoypadButton,"device":-1,"button_index":6,"pressed":true)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"

[physics]

3d/physics_engine="Jolt Physics"
common/max_physics_steps_per_frame=4

[rendering]

anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.03, 0.12, 0.12, 1)
lights_and_shadows/directional_shadow/size=4096
